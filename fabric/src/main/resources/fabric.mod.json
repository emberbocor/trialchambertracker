{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Shows trial spawner cooldowns and which vaults you have opened. Client-side only.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/trialchambertracker",
    "sources": "https://github.com/emberbocor/trialchambertracker",
    "issues": "https://github.com/emberbocor/trialchambertracker/issues"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.emberbocor.trialchambertracker.TrialChamberTrackerFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
